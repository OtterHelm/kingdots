{
  "name": "kingdots",
  "version": "0.1.3",
  "description": "Local MCP bridge for Dots to observe existing Codex coding sessions, record scoped follow-ups, and track delivery and completion evidence. Development preview.",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "codex",
    "mcp",
    "session-management",
    "local-first",
    "typescript",
    "windows",
    "oauth2"
  ],
  "homepage": "https://github.com/OtterHelm/kingdots#readme",
  "bugs": {
    "url": "https://github.com/OtterHelm/kingdots/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "kingdots": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./adapter": "./dist/adapters/types.js"
  },
  "files": [
    "dist",
    "web-dist",
    "plugins",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OtterHelm/kingdots.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:live": "tsx scripts/live-codex.ts",
    "dev": "tsx src/cli.ts serve",
    "dev:web": "vite --host 127.0.0.1",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@opencode-ai/sdk": "^1.18.34",
    "@opencode/client": "^2.0.22",
    "fastify": "^5.12.5",
    "ipaddr.js": "^2.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
